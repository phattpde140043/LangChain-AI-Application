# OpenAI / LLM
OPENAI_API_KEY=your-openai-api-key-here
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Store
VECTOR_DB_PATH=./data/vector_store
VECTOR_DB_TYPE=chroma

# RAG
MAX_CONTEXT_TOKENS=4000
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# API Security (leave API_KEY empty to disable authentication)
API_KEY=your-api-key-here
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Redis
REDIS_URL=redis://localhost:6379

# Prompts & Profiles
ACTIVE_RAG_PROMPT=rag_prompt_v1
ACTIVE_PROFILE=development

# Feature Flags
ENABLE_HYBRID_RETRIEVAL=true
ENABLE_QUERY_EXPANSION=true
ENABLE_CONTEXT_COMPRESSION=false
ENABLE_SAFETY_CHECKS=true
ENABLE_COST_TRACKING=true
ENABLE_STREAMING=true

# Paths
DATA_DIR=./data
DOCUMENTS_DIR=./documents
PROMPTS_DIR=./prompts
EVAL_DATASET_PATH=./data/eval_dataset.json
FEEDBACK_LOG_PATH=./data/feedback.jsonl
METRICS_LOG_PATH=./data/metrics.jsonl
COST_LOG_PATH=./data/costs.jsonl
